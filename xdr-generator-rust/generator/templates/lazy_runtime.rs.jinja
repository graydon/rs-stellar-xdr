impl<const N: usize> LazyXdr for [u8; N] {
    type Eager = [u8; N];

    fn lazy_validate(buf: &[u8], offset: u32, _limits: &mut Limits) -> Result<u32, Error> {
        let n = N as u32;
        let pad = pad_len_ref(n);
        let total = n.checked_add(pad).ok_or(Error::LengthExceedsMax)?;
        check_bounds(buf, offset, total)?;
        let pad_offset = offset.checked_add(n).ok_or(Error::LengthExceedsMax)?;
        check_padding(buf, pad_offset, pad)?;
        Ok(total)
    }

    fn lazy_len(_buf: &[u8], _offset: u32) -> Result<u32, Error> {
        let n = N as u32;
        n.checked_add(pad_len_ref(n)).ok_or(Error::LengthExceedsMax)
    }
}

impl<const N: usize> TryFrom<LazyHandle> for [u8; N] {
    type Error = Error;

    fn try_from(xdr: LazyHandle) -> Result<Self, Self::Error> {
        xdr.get_fixed::<N>()
    }
}

#[derive(Clone, Debug, Hash, PartialEq, Eq, PartialOrd, Ord)]
pub struct LazyOption<T: LazyXdr>(LazyHandle, core::marker::PhantomData<fn() -> T>);

impl<T: LazyXdr> LazyOption<T> {
    pub fn new(xdr: LazyHandle) -> Self {
        Self(xdr, core::marker::PhantomData)
    }

    pub fn is_some(&self) -> Result<bool, Error> {
        Ok(read_u32_at(self.0.buf.as_ref(), self.0.pos)? == 1)
    }

    pub fn value(&self) -> Result<Option<T>, Error> {
        match read_u32_at(self.0.buf.as_ref(), self.0.pos)? {
            0 => Ok(None),
            1 => {
                let inner_pos = self.0.pos.checked_add(4).ok_or(Error::LengthExceedsMax)?;
                let inner = LazyHandle::from_bounds(self.0.buf.clone(), inner_pos, self.0.end)?;
                Ok(Some(T::try_from(inner)?))
            }
            _ => Err(Error::Invalid),
        }
    }

    #[cfg(feature = "std")]
    pub fn to_eager(&self) -> Result<Option<T::Eager>, Error>
    where
        Option<T::Eager>: ReadXdr,
    {
        Option::<T::Eager>::from_xdr(self.0.as_slice()?, Limits::len(self.0.len() as usize))
    }

    pub fn to_xdr_vec(&self) -> Result<Vec<u8>, Error> {
        Ok(self.0.as_slice()?.to_vec())
    }
}

impl<T: LazyXdr> LazyXdr for LazyOption<T> {
    type Eager = Option<T::Eager>;

    fn lazy_validate(buf: &[u8], offset: u32, limits: &mut Limits) -> Result<u32, Error> {
        match read_u32_at(buf, offset)? {
            0 => Ok(4),
            1 => {
                let inner_pos = offset.checked_add(4).ok_or(Error::LengthExceedsMax)?;
                let inner_len = T::lazy_validate(buf, inner_pos, limits)?;
                4u32.checked_add(inner_len).ok_or(Error::LengthExceedsMax)
            }
            _ => Err(Error::Invalid),
        }
    }

    fn lazy_len(buf: &[u8], offset: u32) -> Result<u32, Error> {
        match read_u32_at(buf, offset)? {
            0 => Ok(4),
            1 => {
                let inner_pos = offset.checked_add(4).ok_or(Error::LengthExceedsMax)?;
                let inner_len = T::lazy_len(buf, inner_pos)?;
                4u32.checked_add(inner_len).ok_or(Error::LengthExceedsMax)
            }
            _ => Err(Error::Invalid),
        }
    }

}

impl<T: LazyXdr> TryFrom<LazyHandle> for LazyOption<T> {
    type Error = Error;

    fn try_from(xdr: LazyHandle) -> Result<Self, Self::Error> {
        Ok(LazyOption::new(xdr))
    }
}

impl<T: LazyXdr> AsRef<LazyHandle> for LazyOption<T> {
    fn as_ref(&self) -> &LazyHandle {
        &self.0
    }
}

