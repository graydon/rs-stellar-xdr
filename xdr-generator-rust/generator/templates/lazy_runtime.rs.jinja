impl LazyXdr for bool {
    type Eager = bool;

    fn lazy_validate(buf: &[u8], offset: u32, _limits: &mut Limits) -> Result<u32, Error> {
        let _ = read_bool_at(buf, offset)?;
        Ok(4)
    }

    fn lazy_len(_buf: &[u8], _offset: u32) -> Result<u32, Error> {
        Ok(4)
    }
