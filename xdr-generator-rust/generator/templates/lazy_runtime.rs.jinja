#[derive(Clone, Debug, Hash, PartialEq, Eq, PartialOrd, Ord)]
pub struct LazyVecM<T: LazyXdr, const MAX: u32 = { u32::MAX }>(LazyHandle, core::marker::PhantomData<fn() -> T>);

impl<T: LazyXdr, const MAX: u32> LazyVecM<T, MAX> {
    pub fn new(xdr: LazyHandle) -> Self {
        Self(xdr, core::marker::PhantomData)
    }

    pub fn len(&self) -> Result<u32, Error> {
        read_u32_at(self.0.buf.as_ref(), self.0.pos)
    }

    pub fn get(&self, index: u32) -> Result<T, Error> {
        let count = self.len()?;
        if index >= count {
            return Err(Error::Invalid);
        }
        let mut pos = self.0.pos.checked_add(4).ok_or(Error::LengthExceedsMax)?;
        for _ in 0..index {
            let item_len = T::lazy_len(self.0.buf.as_ref(), pos)?;
            pos = pos.checked_add(item_len).ok_or(Error::LengthExceedsMax)?;
        }
        let item_len = T::lazy_len(self.0.buf.as_ref(), pos)?;
        let item_ref = LazyHandle::new(self.0.buf.clone(), pos, item_len)?;
        T::try_from(item_ref)
    }

    #[cfg(feature = "std")]
    pub fn to_eager(&self) -> Result<super::VecM<T::Eager, MAX>, Error>
    where
        super::VecM<T::Eager, MAX>: ReadXdr,
    {
        super::VecM::<T::Eager, MAX>::from_xdr(
            self.0.as_slice()?,
            Limits::len(self.0.len() as usize),
        )
    }

    pub fn to_xdr_vec(&self) -> Result<Vec<u8>, Error> {
        Ok(self.0.as_slice()?.to_vec())
    }
}

impl<T: LazyXdr, const MAX: u32> LazyXdr for LazyVecM<T, MAX> {
    type Eager = super::VecM<T::Eager, MAX>;

    fn lazy_validate(buf: &[u8], offset: u32, limits: &mut Limits) -> Result<u32, Error> {
        let count = read_u32_at(buf, offset)?;
        if count > MAX {
            return Err(Error::LengthExceedsMax);
        }
        let mut pos = offset.checked_add(4).ok_or(Error::LengthExceedsMax)?;
        for _ in 0..count {
            let item_len = T::lazy_validate(buf, pos, limits)?;
            pos = pos.checked_add(item_len).ok_or(Error::LengthExceedsMax)?;
        }
        pos.checked_sub(offset).ok_or(Error::Invalid)
    }

    fn lazy_len(buf: &[u8], offset: u32) -> Result<u32, Error> {
        let count = read_u32_at(buf, offset)?;
        let mut pos = offset.checked_add(4).ok_or(Error::LengthExceedsMax)?;
        for _ in 0..count {
            let item_len = T::lazy_len(buf, pos)?;
            pos = pos.checked_add(item_len).ok_or(Error::LengthExceedsMax)?;
        }
        pos.checked_sub(offset).ok_or(Error::Invalid)
    }

}

impl<T: LazyXdr, const MAX: u32> TryFrom<LazyHandle> for LazyVecM<T, MAX> {
    type Error = Error;

    fn try_from(xdr: LazyHandle) -> Result<Self, Self::Error> {
        Ok(LazyVecM::new(xdr))
    }
}

impl<T: LazyXdr, const MAX: u32> AsRef<LazyHandle> for LazyVecM<T, MAX> {
    fn as_ref(&self) -> &LazyHandle {
        &self.0
    }
}

#[derive(Clone, Debug, Hash, PartialEq, Eq, PartialOrd, Ord)]
pub struct LazyBytesM<const MAX: u32 = { u32::MAX }>(LazyHandle);

impl<const MAX: u32> LazyBytesM<MAX> {
    pub fn len(&self) -> Result<u32, Error> {
        read_u32_at(self.0.buf.as_ref(), self.0.pos)
    }

    pub fn as_bytes(&self) -> Result<&[u8], Error> {
        let data_len = self.len()?;
        let data_pos = self.0.pos.checked_add(4).ok_or(Error::LengthExceedsMax)?;
        read_bytes_at(self.0.buf.as_ref(), data_pos, data_len)
    }

    #[cfg(feature = "std")]
    pub fn to_eager(&self) -> Result<super::BytesM<MAX>, Error>
    where
        super::BytesM<MAX>: ReadXdr,
    {
        super::BytesM::<MAX>::from_xdr(self.0.as_slice()?, Limits::len(self.0.len() as usize))
    }

    pub fn to_xdr_vec(&self) -> Result<Vec<u8>, Error> {
        Ok(self.0.as_slice()?.to_vec())
    }
}

impl<const MAX: u32> LazyXdr for LazyBytesM<MAX> {
    type Eager = super::BytesM<MAX>;

    fn lazy_validate(buf: &[u8], offset: u32, _limits: &mut Limits) -> Result<u32, Error> {
        Ok(var_opaque_xdr_len(buf, offset, MAX)?.1)
    }

    fn lazy_len(buf: &[u8], offset: u32) -> Result<u32, Error> {
        var_opaque_len_trusted(buf, offset)
    }

}

impl<const MAX: u32> TryFrom<LazyHandle> for LazyBytesM<MAX> {
    type Error = Error;

    fn try_from(xdr: LazyHandle) -> Result<Self, Self::Error> {
        Ok(LazyBytesM(xdr))
    }
}

impl<const MAX: u32> AsRef<LazyHandle> for LazyBytesM<MAX> {
    fn as_ref(&self) -> &LazyHandle {
        &self.0
    }
}

#[derive(Clone, Debug, Hash, PartialEq, Eq, PartialOrd, Ord)]
pub struct LazyStringM<const MAX: u32 = { u32::MAX }>(LazyHandle);

impl<const MAX: u32> LazyStringM<MAX> {
    pub fn len(&self) -> Result<u32, Error> {
        read_u32_at(self.0.buf.as_ref(), self.0.pos)
    }

    pub fn as_bytes(&self) -> Result<&[u8], Error> {
        let data_len = self.len()?;
        let data_pos = self.0.pos.checked_add(4).ok_or(Error::LengthExceedsMax)?;
        read_bytes_at(self.0.buf.as_ref(), data_pos, data_len)
    }

    pub fn as_str(&self) -> Result<&str, Error> {
        Ok(core::str::from_utf8(self.as_bytes()?)?)
    }

    #[cfg(feature = "std")]
    pub fn to_eager(&self) -> Result<super::StringM<MAX>, Error>
    where
        super::StringM<MAX>: ReadXdr,
    {
        super::StringM::<MAX>::from_xdr(self.0.as_slice()?, Limits::len(self.0.len() as usize))
    }

    pub fn to_xdr_vec(&self) -> Result<Vec<u8>, Error> {
        Ok(self.0.as_slice()?.to_vec())
    }
}

impl<const MAX: u32> LazyXdr for LazyStringM<MAX> {
    type Eager = super::StringM<MAX>;

    fn lazy_validate(buf: &[u8], offset: u32, _limits: &mut Limits) -> Result<u32, Error> {
        let (data_len, total) = var_opaque_xdr_len(buf, offset, MAX)?;
        let data_pos = offset.checked_add(4).ok_or(Error::LengthExceedsMax)?;
        let data = read_bytes_at(buf, data_pos, data_len)?;
        let _ = core::str::from_utf8(data)?;
        Ok(total)
    }

    fn lazy_len(buf: &[u8], offset: u32) -> Result<u32, Error> {
        var_opaque_len_trusted(buf, offset)
    }

}

impl<const MAX: u32> TryFrom<LazyHandle> for LazyStringM<MAX> {
    type Error = Error;

    fn try_from(xdr: LazyHandle) -> Result<Self, Self::Error> {
        Ok(LazyStringM(xdr))
    }
}

impl<const MAX: u32> AsRef<LazyHandle> for LazyStringM<MAX> {
    fn as_ref(&self) -> &LazyHandle {
        &self.0
    }
}

#[derive(Clone, Debug, Hash, PartialEq, Eq, PartialOrd, Ord)]
pub struct LazyArray<T: LazyXdr, const N: usize>(LazyHandle, core::marker::PhantomData<fn() -> T>);

impl<T: LazyXdr, const N: usize> LazyArray<T, N> {
    pub fn new(xdr: LazyHandle) -> Self {
        Self(xdr, core::marker::PhantomData)
    }

    pub const fn len(&self) -> usize {
        N
    }

    pub fn get(&self, index: usize) -> Result<T, Error> {
        if index >= N {
            return Err(Error::Invalid);
        }
        let mut pos = self.0.pos;
        for _ in 0..index {
            let item_len = T::lazy_len(self.0.buf.as_ref(), pos)?;
            pos = pos.checked_add(item_len).ok_or(Error::LengthExceedsMax)?;
        }
        let item_len = T::lazy_len(self.0.buf.as_ref(), pos)?;
        let item_ref = LazyHandle::new(self.0.buf.clone(), pos, item_len)?;
        T::try_from(item_ref)
    }

    #[cfg(feature = "std")]
    pub fn to_eager(&self) -> Result<[T::Eager; N], Error>
    where
        [T::Eager; N]: ReadXdr,
    {
        <[T::Eager; N]>::from_xdr(self.0.as_slice()?, Limits::len(self.0.len() as usize))
    }

    pub fn to_xdr_vec(&self) -> Result<Vec<u8>, Error> {
        Ok(self.0.as_slice()?.to_vec())
    }
}

impl<T: LazyXdr, const N: usize> LazyXdr for LazyArray<T, N> {
    type Eager = [T::Eager; N];

    fn lazy_validate(buf: &[u8], offset: u32, limits: &mut Limits) -> Result<u32, Error> {
        let mut pos = offset;
        for _ in 0..N {
            let item_len = T::lazy_validate(buf, pos, limits)?;
            pos = pos.checked_add(item_len).ok_or(Error::LengthExceedsMax)?;
        }
        pos.checked_sub(offset).ok_or(Error::Invalid)
    }

    fn lazy_len(buf: &[u8], offset: u32) -> Result<u32, Error> {
        let mut pos = offset;
        for _ in 0..N {
            let item_len = T::lazy_len(buf, pos)?;
            pos = pos.checked_add(item_len).ok_or(Error::LengthExceedsMax)?;
        }
        pos.checked_sub(offset).ok_or(Error::Invalid)
    }

}

impl<T: LazyXdr, const N: usize> TryFrom<LazyHandle> for LazyArray<T, N> {
    type Error = Error;

    fn try_from(xdr: LazyHandle) -> Result<Self, Self::Error> {
        Ok(LazyArray::new(xdr))
    }
}

impl<T: LazyXdr, const N: usize> AsRef<LazyHandle> for LazyArray<T, N> {
    fn as_ref(&self) -> &LazyHandle {
        &self.0
    }
}