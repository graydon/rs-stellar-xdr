#[allow(clippy::too_many_lines, clippy::missing_errors_doc)]

use core::fmt;

#[cfg(feature = "std")]
use std::{boxed::Box, sync::Arc, vec::Vec};

#[cfg(all(not(feature = "std"), feature = "alloc"))]
use alloc::{boxed::Box, sync::Arc, vec::Vec};

#[derive(Clone, Hash, PartialEq, Eq, PartialOrd, Ord)]
pub struct LazyHandle {
    buf: Arc<[u8]>,
    pos: u32,
    end: u32,
}

impl fmt::Debug for LazyHandle {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_struct("LazyHandle")
            .field("pos", &self.pos)
            .field("end", &self.end)
            .finish()
    }
}

impl LazyHandle {
    pub fn new(buf: Arc<[u8]>, pos: u32, len: u32) -> Result<Self, Error> {
        let end = pos.checked_add(len).ok_or(Error::LengthExceedsMax)?;
        if end as usize > buf.len() {
            return Err(Error::Invalid);
        }
        Ok(Self { buf, pos, end })
    }

    pub fn from_bounds(buf: Arc<[u8]>, pos: u32, end: u32) -> Result<Self, Error> {
        if pos > end || end as usize > buf.len() {
            return Err(Error::Invalid);
        }
        Ok(Self { buf, pos, end })
    }

    pub fn from_serialized_vec(bytes: Vec<u8>) -> Result<Self, Error> {
        let arc: Arc<[u8]> = Arc::from(bytes);
        let end = u32::try_from(arc.len()).map_err(|_| Error::LengthExceedsMax)?;
        Self::from_bounds(arc, 0, end)
    }

    #[must_use]
    pub fn buf_arc(&self) -> Arc<[u8]> {
        self.buf.clone()
    }

    #[must_use]
    pub const fn pos(&self) -> u32 {
        self.pos
    }

    #[must_use]
    pub const fn end(&self) -> u32 {
        self.end
    }

    #[must_use]
    pub const fn len(&self) -> u32 {
        self.end - self.pos
    }

    #[must_use]
    pub const fn is_empty(&self) -> bool {
        self.pos == self.end
    }

    pub fn as_slice(&self) -> Result<&[u8], Error> {
        let start = self.pos as usize;
        let end = self.end as usize;
        if end > self.buf.len() || start > end {
            return Err(Error::Invalid);
        }
        Ok(&self.buf[start..end])
    }
}

pub trait LazyXdr: Sized + TryFrom<LazyHandle, Error = Error> {
    type Eager;

    fn lazy_validate(buf: &[u8], offset: u32, limits: &mut Limits) -> Result<u32, Error>;

    fn lazy_len(buf: &[u8], offset: u32) -> Result<u32, Error>;
}

#[inline]
pub fn lazy_from_arc<T: LazyXdr>(buf: Arc<[u8]>) -> Result<T, Error> {
    let mut limits = Limits::none();
    let len = T::lazy_validate(buf.as_ref(), 0, &mut limits)?;
    let end = u32::try_from(buf.len()).map_err(|_| Error::LengthExceedsMax)?;
    if len != end {
        return Err(Error::Invalid);
    }
    T::try_from(LazyHandle::from_bounds(buf, 0, end)?)
}

#[inline]
pub fn lazy_from_vec<T: LazyXdr>(bytes: Vec<u8>) -> Result<T, Error> {
    lazy_from_arc(Arc::from(bytes))
}

#[inline]
pub fn lazy_to_xdr_vec<T>(value: &T) -> Result<Vec<u8>, Error>
where
    T: AsRef<LazyHandle>,
{
    Ok(value.as_ref().as_slice()?.to_vec())
}

#[cfg(feature = "std")]
pub fn lazy_to_eager<T>(value: &T) -> Result<T::Eager, Error>
where
    T: LazyXdr + AsRef<LazyHandle>,
    T::Eager: ReadXdr,
{
    <T::Eager as ReadXdr>::from_xdr(
        value.as_ref().as_slice()?,
        Limits::len(value.as_ref().len() as usize),
    )
}

#[cfg(feature = "std")]
pub fn lazy_from_eager_ref<T>(value: &T::Eager) -> Result<T, Error>
where
    T: LazyXdr,
    T::Eager: WriteXdr,
{
    lazy_from_vec(value.to_xdr(Limits::none())?)
}

pub fn lazy_boxed_from_xdr<T: LazyXdr>(bytes: Vec<u8>) -> Result<Box<T>, Error> {
    Ok(Box::new(lazy_from_vec(bytes)?))
}

#[inline]
pub const fn pad_len_ref(len: u32) -> u32 {
    (4u32.wrapping_sub(len % 4)) % 4
}

#[inline]
pub fn read_bytes_at(buf: &[u8], offset: u32, len: u32) -> Result<&[u8], Error> {
    let off = offset as usize;
    let end = off.checked_add(len as usize).ok_or(Error::LengthExceedsMax)?;
    if end > buf.len() {
        return Err(Error::Invalid);
    }
    Ok(&buf[off..end])
}

#[inline]
pub fn read_u32_at(buf: &[u8], offset: u32) -> Result<u32, Error> {
    let bytes = read_bytes_at(buf, offset, 4)?;
    let arr: [u8; 4] = bytes.try_into().map_err(|_| Error::Invalid)?;
    Ok(u32::from_be_bytes(arr))
}

#[inline]
pub fn read_i32_at(buf: &[u8], offset: u32) -> Result<i32, Error> {
    let bytes = read_bytes_at(buf, offset, 4)?;
    let arr: [u8; 4] = bytes.try_into().map_err(|_| Error::Invalid)?;
    Ok(i32::from_be_bytes(arr))
}

#[inline]
pub fn read_u64_at(buf: &[u8], offset: u32) -> Result<u64, Error> {
    let bytes = read_bytes_at(buf, offset, 8)?;
    let arr: [u8; 8] = bytes.try_into().map_err(|_| Error::Invalid)?;
    Ok(u64::from_be_bytes(arr))
}

#[inline]
pub fn read_i64_at(buf: &[u8], offset: u32) -> Result<i64, Error> {
    let bytes = read_bytes_at(buf, offset, 8)?;
    let arr: [u8; 8] = bytes.try_into().map_err(|_| Error::Invalid)?;
    Ok(i64::from_be_bytes(arr))
}

#[inline]
pub fn read_bool_at(buf: &[u8], offset: u32) -> Result<bool, Error> {
    match read_u32_at(buf, offset)? {
        0 => Ok(false),
        1 => Ok(true),
        _ => Err(Error::Invalid),
    }
}

#[inline]
pub fn check_bounds(buf: &[u8], offset: u32, additional: u32) -> Result<(), Error> {
    let end = (offset as usize)
        .checked_add(additional as usize)
        .ok_or(Error::LengthExceedsMax)?;
    if end > buf.len() {
        Err(Error::Invalid)
    } else {
        Ok(())
    }
}

#[inline]
pub fn check_padding(buf: &[u8], offset: u32, pad: u32) -> Result<(), Error> {
    if pad == 0 {
        return Ok(());
    }
    let bytes = read_bytes_at(buf, offset, pad)?;
    if bytes.iter().any(|&b| b != 0) {
        return Err(Error::NonZeroPadding);
    }
    Ok(())
}

#[inline]
pub fn var_opaque_xdr_len(buf: &[u8], offset: u32, max: u32) -> Result<(u32, u32), Error> {
    let data_len = read_u32_at(buf, offset)?;
    if data_len > max {
        return Err(Error::LengthExceedsMax);
    }
    let pad = pad_len_ref(data_len);
    let total = 4u32
        .checked_add(data_len)
        .and_then(|v| v.checked_add(pad))
        .ok_or(Error::LengthExceedsMax)?;
    check_bounds(buf, offset, total)?;
    let pad_offset = offset
        .checked_add(4)
        .and_then(|v| v.checked_add(data_len))
        .ok_or(Error::LengthExceedsMax)?;
    check_padding(buf, pad_offset, pad)?;
    Ok((data_len, total))
}

#[inline]
pub fn var_opaque_len_trusted(buf: &[u8], offset: u32) -> Result<u32, Error> {
    let data_len = read_u32_at(buf, offset)?;
    let pad = pad_len_ref(data_len);
    let total = 4u32
        .checked_add(data_len)
        .and_then(|value| value.checked_add(pad))
        .ok_or(Error::LengthExceedsMax)?;
    check_bounds(buf, offset, total)?;
    Ok(total)
}

#[inline]
pub fn checked_add_u32(lhs: u32, rhs: u32) -> Result<u32, Error> {
    lhs.checked_add(rhs).ok_or(Error::LengthExceedsMax)
}

#[inline]
pub fn checked_mul_u32(lhs: u32, rhs: u32) -> Result<u32, Error> {
    lhs.checked_mul(rhs).ok_or(Error::LengthExceedsMax)
}

#[inline]
pub fn size_as_u32<T>(value: T) -> Result<u32, Error>
where
    u32: TryFrom<T>,
{
    u32::try_from(value).map_err(|_| Error::LengthExceedsMax)
}

#[inline]
pub fn fixed_opaque_len<T>(size: T) -> Result<u32, Error>
where
    u32: TryFrom<T>,
{
    let len = size_as_u32(size)?;
    checked_add_u32(len, pad_len_ref(len))
}

impl LazyHandle {
    pub fn get_i32(&self) -> Result<i32, Error> {
        read_i32_at(self.buf.as_ref(), self.pos)
    }

    pub fn get_u32(&self) -> Result<u32, Error> {
        read_u32_at(self.buf.as_ref(), self.pos)
    }

    pub fn get_i64(&self) -> Result<i64, Error> {
        read_i64_at(self.buf.as_ref(), self.pos)
    }

    pub fn get_u64(&self) -> Result<u64, Error> {
        read_u64_at(self.buf.as_ref(), self.pos)
    }

    pub fn get_bool(&self) -> Result<bool, Error> {
        read_bool_at(self.buf.as_ref(), self.pos)
    }

    pub fn get_fixed<const N: usize>(&self) -> Result<[u8; N], Error> {
        let bytes = read_bytes_at(self.buf.as_ref(), self.pos, N as u32)?;
        bytes.try_into().map_err(|_| Error::Invalid)
    }

    pub fn as_fixed_bytes<const N: usize>(&self) -> Result<&[u8], Error> {
        read_bytes_at(self.buf.as_ref(), self.pos, N as u32)
    }
}

impl LazyXdr for i32 {
    type Eager = i32;

    fn lazy_validate(buf: &[u8], offset: u32, _limits: &mut Limits) -> Result<u32, Error> {
        check_bounds(buf, offset, 4)?;
        Ok(4)
    }

    fn lazy_len(_buf: &[u8], _offset: u32) -> Result<u32, Error> {
        Ok(4)
    }
}

impl TryFrom<LazyHandle> for i32 {
    type Error = Error;

    fn try_from(xdr: LazyHandle) -> Result<Self, Self::Error> {
        xdr.get_i32()
    }
}

