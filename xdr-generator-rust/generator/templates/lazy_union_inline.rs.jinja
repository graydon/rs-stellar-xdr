impl LazyXdr for {{ u.lazy_name }} {
    fn xdr_validate(buf: &[u8], depth: u32) -> Result<u32, Error> {
        #[allow(unused_variables)]
        let depth = depth.checked_sub(1).ok_or(Error::DepthLimitExceeded)?;
        if buf.len() < 4 {
            return Err(Error::Invalid);
        }
        let bytes: [u8; 4] = buf[..4].try_into().unwrap();
        let disc = i32::from_be_bytes(bytes);
        #[allow(unused_mut)]
        let mut pos: u32 = 4;
        #[allow(clippy::match_same_arms)]
        match disc {
{%- for arm in u.arms %}
{%- if let Some(cfg) = arm.cfg %}
            #[cfg({{ cfg }})]
{%- endif %}
            {{ arm.case_value_i32 }} => {
{%- if arm.is_void %}
                // void — no additional data
{%- else %}
                let field_len = <{{ arm.lazy_type.as_ref().unwrap() }} as LazyXdr>::xdr_validate(&buf[pos as usize..], depth)?;
                pos = pos.checked_add(field_len).ok_or(Error::LengthExceedsMax)?;
{%- endif %}
            }
{%- endfor %}
            _ => return Err(Error::Invalid),
        }
        Ok(pos)
    }

    fn xdr_len(buf: &[u8]) -> u32 {
        let bytes: [u8; 4] = buf[..4].try_into().unwrap();
        let disc = i32::from_be_bytes(bytes);
        #[allow(unused_mut)]
        let mut pos: u32 = 4;
        #[allow(clippy::match_same_arms)]
        match disc {
{%- for arm in u.arms %}
{%- if let Some(cfg) = arm.cfg %}
            #[cfg({{ cfg }})]
{%- endif %}
            {{ arm.case_value_i32 }} => {
{%- if arm.is_void %}
                // void
{%- else %}
                pos += <{{ arm.lazy_type.as_ref().unwrap() }} as LazyXdr>::xdr_len(&buf[pos as usize..]);
{%- endif %}
            }
{%- endfor %}
            _ => {}
        }
        pos
    }

    fn from_xdr_consume(parent: &LazyHandle, buf: &mut &[u8]) -> Self {
        let len = Self::xdr_len(buf);
        let offset = (parent.len() as usize - buf.len()) as u32;
        let handle = parent.sub_handle(offset, len);
        *buf = &buf[len as usize..];
        Self(handle)
    }
}

