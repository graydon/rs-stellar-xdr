    // Enum {{ e.name }}: scalar lazy type — impl LazyXdr directly on the enum.
    impl LazyXdr for super::{{ e.name }} {
        const FIXED_XDR_SIZE: Option<u32> = Some(4);

        fn xdr_validate(buf: &[u8], _depth: u32) -> Result<u32, super::Error> {
            if buf.len() < 4 {
                return Err(super::Error::Invalid);
            }
            let bytes: [u8; 4] = buf[..4].try_into().unwrap();
            let v = i32::from_be_bytes(bytes);
            let _ = super::{{ e.name }}::try_from(v)?;
            Ok(4)
        }

        #[inline]
        fn xdr_len(_buf: &[u8]) -> u32 {
            4
        }

        #[inline]
        fn from_xdr_consume(_parent: &LazyHandle, buf: &mut &[u8]) -> Self {
            let bytes: [u8; 4] = buf[..4].try_into().unwrap();
            *buf = &buf[4..];
            let v = i32::from_be_bytes(bytes);
            // SAFETY: data was validated; unwrap is infallible.
            super::{{ e.name }}::try_from(v).unwrap()
        }
    }
