    /// Lazy wrapper for [`super::{{ s.name }}`].
    #[derive(Clone, Debug, Hash, PartialEq, Eq)]
    pub struct {{ s.lazy_name }}(LazyHandle);

{%- if let Some(cfg_attr) = s.cfg %}
    #[cfg({{ cfg_attr }})]
{%- endif %}
    impl PartialOrd for {{ s.lazy_name }} {
        fn partial_cmp(&self, other: &Self) -> Option<core::cmp::Ordering> {
            Some(self.cmp(other))
        }
    }

{%- if let Some(cfg_attr) = s.cfg %}
    #[cfg({{ cfg_attr }})]
{%- endif %}
    impl Ord for {{ s.lazy_name }} {
        fn cmp(&self, other: &Self) -> core::cmp::Ordering {
            core::cmp::Ordering::Equal
{%- for m in s.members %}
                .then_with(|| self.{{ m.name }}().cmp(&other.{{ m.name }}()))
{%- endfor %}
        }
    }

{%- if let Some(cfg_attr) = s.cfg %}
    #[cfg({{ cfg_attr }})]
{%- endif %}
    impl LazyXdr for {{ s.lazy_name }} {
{%- if let Some(fs) = s.lazy_fixed_size %}
        const FIXED_XDR_SIZE: Option<u32> = Some({{ fs }});
{%- endif %}

        fn xdr_validate(buf: &[u8], depth: u32) -> Result<u32, super::Error> {
            #[allow(unused_variables)]
            let depth = depth.checked_sub(1).ok_or(super::Error::DepthLimitExceeded)?;
            let mut pos: u32 = 0;
{%- for step in s.lazy_validate_steps %}
{%- match step %}
{%- when LazyValidateStep::FixedGroup(g) %}
{%- if g.total_fixed > 0 %}
            let next_pos = pos.checked_add({{ g.total_fixed }}).ok_or(super::Error::LengthExceedsMax)?;
            if buf.len() < next_pos as usize {
                return Err(super::Error::Invalid);
            }
{%- for cv in g.content_validations %}
            <{{ cv.lazy_type }} as LazyXdr>::xdr_validate(&buf[(pos + {{ cv.offset }}) as usize..], depth)?;
{%- endfor %}
            pos = next_pos;
{%- endif %}
{%- when LazyValidateStep::Variable(v) %}
            {
                let field_len = <{{ v.lazy_type }} as LazyXdr>::xdr_validate(&buf[pos as usize..], depth)?;
                pos = pos.checked_add(field_len).ok_or(super::Error::LengthExceedsMax)?;
            }
{%- endmatch %}
{%- endfor %}
            Ok(pos)
        }

{%- if let Some(fs) = s.lazy_fixed_size %}

        #[inline]
        fn xdr_len(_buf: &[u8]) -> u32 {
            {{ fs }}
        }
{%- else %}

        fn xdr_len(buf: &[u8]) -> u32 {
            let mut pos: u32 = 0;
{%- for step in s.lazy_validate_steps %}
{%- match step %}
{%- when LazyValidateStep::FixedGroup(g) %}
{%- if g.total_fixed > 0 %}
            pos += {{ g.total_fixed }};
{%- endif %}
{%- when LazyValidateStep::Variable(v) %}
            pos += <{{ v.lazy_type }} as LazyXdr>::xdr_len(&buf[pos as usize..]);
{%- endmatch %}
{%- endfor %}
            pos
        }
{%- endif %}

        fn from_xdr_consume(parent: &LazyHandle, buf: &mut &[u8]) -> Self {
            let len = Self::xdr_len(buf);
            let offset = (parent.len() as usize - buf.len()) as u32;
            let handle = parent.sub_handle(offset, len);
            *buf = &buf[len as usize..];
            Self(handle)
        }
    }

{%- if let Some(cfg_attr) = s.cfg %}
    #[cfg({{ cfg_attr }})]
{%- endif %}
    impl From<LazyHandle> for {{ s.lazy_name }} {
        fn from(h: LazyHandle) -> Self {
            Self(h)
        }
    }

{%- if let Some(cfg_attr) = s.cfg %}
    #[cfg({{ cfg_attr }})]
{%- endif %}
    impl AsRef<LazyHandle> for {{ s.lazy_name }} {
