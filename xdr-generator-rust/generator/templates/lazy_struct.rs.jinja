        }
    }

{%- if let Some(cfg_attr) = s.cfg %}
    #[cfg({{ cfg_attr }})]
{%- endif %}
    impl TryFrom<Arc<[u8]>> for {{ s.lazy_name }} {
        type Error = super::Error;
        fn try_from(buf: Arc<[u8]>) -> Result<Self, super::Error> {
            let len = Self::xdr_validate(&buf, DEFAULT_XDR_DEPTH_LIMIT)?;
            Ok(Self(LazyHandle::from_arc(buf, 0, len)))
        }
    }

{%- if let Some(cfg_attr) = s.cfg %}
    #[cfg({{ cfg_attr }})]
{%- endif %}
    impl {{ s.lazy_name }} {
{%- for m in s.members %}
        /// Access field `{{ m.name }}`.
        #[must_use]
{%- if m.lazy_accessor.var_skips.is_empty() %}
        pub fn {{ m.name }}(&self) -> {{ m.lazy_type }} {
            <{{ m.lazy_type }} as LazyXdr>::from_xdr_at(&self.0, {{ m.lazy_accessor.initial_fixed }})
        }
{%- else %}
        pub fn {{ m.name }}(&self) -> {{ m.lazy_type }} {
            let buf = self.0.as_slice();
            let mut pos: u32 = {{ m.lazy_accessor.initial_fixed }};
{%- for skip in m.lazy_accessor.var_skips %}
            pos += <{{ skip.lazy_type }} as LazyXdr>::xdr_len(&buf[pos as usize..]);
{%- if skip.post_fixed > 0 %}
            pos += {{ skip.post_fixed }};
{%- endif %}
{%- endfor %}
            <{{ m.lazy_type }} as LazyXdr>::from_xdr_at(&self.0, pos)
        }
{%- endif %}
{%- endfor %}
    }
